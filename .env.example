# ---------- runtime ----------
APP_ENV=dev
# Local laptop (no docker): SQLite + in-process queue
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
QUEUE_BACKEND=memory
# With docker compose: switch to these two lines
# DATABASE_URL=postgresql+asyncpg://prreview:prreview@127.0.0.1:5432/prreview
# QUEUE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- github ----------
# openssl rand -hex 32  (also used to sign local replay requests)
GITHUB_WEBHOOK_SECRET=change-me-in-local
# Fine-grained PAT: Pull requests (read/write) + Contents (read). Leave empty for dry-run.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
# true = build the review payload and record it, never call GitHub write APIs
GITHUB_DRY_RUN=true

# ---------- reviewer engine ----------
# fake = deterministic rule engine (offline, always works)
# cli  = upstream open-code-review CLI (needs `ocr` on PATH + model configured)
OCR_MODE=fake
OCR_COMMAND=ocr
OCR_TIMEOUT_S=600
RULES_DIR=./rules
MAX_FINDINGS_PER_FILE=10

# ---------- secrets at rest ----------
# Fernet key for repo tokens: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=
