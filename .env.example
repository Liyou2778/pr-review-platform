# ---------- runtime ----------
APP_ENV=dev
# Local laptop (no docker): SQLite + in-process queue
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
QUEUE_BACKEND=memory
# With docker compose: switch to these two lines
# DATABASE_URL=postgresql+asyncpg://prreview:prreview@127.0.0.1:5432/prreview
# QUEUE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- github ----------
# openssl rand -hex 32  (also used to sign local replay requests)
GITHUB_WEBHOOK_SECRET=change-me-in-local
# Fine-grained PAT: Pull requests (read/write) + Contents (read) + Workflows (read/write)
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
# true = build the review payload and record it, never call GitHub write APIs
GITHUB_DRY_RUN=true

# ---------- API hardening ----------
# When set, every mutating /api/* call needs `X-API-Token: <value>`.
# Non-dev environments refuse mutating calls if this is empty.
API_TOKEN=
# Only these hosts may be cloned from (comma separated, https only).
ALLOWED_CLONE_HOSTS=github.com
MAX_REQUEST_BYTES=2000000
# Read + write API calls need X-API-Token when set; non-dev refuses writes without it.

# ---------- worker / delivery ----------
WORKER_CONCURRENCY=2
POST_RETRIES=3
# 0 = unlimited (can be overridden per repo via /policy)
REPO_HOURLY_RUN_LIMIT=0
# 0 = keep forever; scripts/retention.py prunes older runs (dry-run by default)
RETENTION_DAYS=30
LOG_JSON=false

# ---------- reviewer engine ----------
# fake = deterministic rule engine (offline, always works)
# cli  = upstream open-code-review CLI (needs `ocr` on PATH + model configured)
OCR_MODE=fake
OCR_COMMAND=ocr
OCR_TIMEOUT_S=600
RULES_DIR=./rules
MAX_FINDINGS_PER_FILE=10

# ---------- secrets at rest ----------
# Fernet key for repo tokens: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=
